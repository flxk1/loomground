{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "loomground",
      "camelcase": "Loomground",
      "scope": "source.lg",
      "file-types": [
        "lg",
        "loom"
      ],
      "injection-regex": "^(lg|loom)$"
    }
  ],
  "metadata": {
    "version": "0.7.0",
    "license": "Apache-2.0",
    "description": "Tree-sitter grammar for the Loomground textual surface (.lg; .loom accepted as a deprecated alias)",
    "authors": [
      {
        "name": "The Loomground Authors"
      }
    ]
  }
}
